# Copy to .env. Never commit real credentials.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/lifeflow.sqlite
# Required (24+ characters) before listening on a LAN interface.
LOCAL_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost
# Both paths enable local HTTPS. Never commit certificate private keys.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Reserved for future integration. No model calls in this milestone.
DEEPSEEK_API_KEY=
