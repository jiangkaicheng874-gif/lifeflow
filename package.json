{
  "name": "lifeflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env build/server/index.js",
    "test": "node --import tsx --test server/app.test.ts src/calendar-layout.test.ts src/time-block-generator.test.ts src/date-utils.test.ts",
    "ios:add": "cap add ios --packagemanager SPM",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:check": "node scripts/check-ios.mjs",
    "remotes:set": "node scripts/remotes.mjs set",
    "push:both": "node scripts/remotes.mjs push"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "4.3.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "8.3.6"
  }
}
